import { useEffect, useMemo, useState, type FormEvent, type ReactNode } from "react";

type Page =
  | "dashboard"
  | "inventario"
  | "ficha"
  | "mantenimiento"
  | "hardware"
  | "repotenciados"
  | "areas"
  | "reportes"
  | "alertas"
  | "administracion";

