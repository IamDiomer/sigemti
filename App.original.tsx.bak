  code: string;
  internal: string;
  name: string;
  type: string;
  brand: string;
  model: string;
  serial: string;
  area: string;
  owner: string;
  status: "Operativo" | "En mantenimiento" | "Repotenciado" | "Fuera de servicio";
  acquired: string;
  maintenance: string;
};

